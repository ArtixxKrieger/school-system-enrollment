Options -MultiViews
RewriteEngine On

# Redirect known PHP entry points to clean routes only when the browser requested the .php file.
RewriteCond %{THE_REQUEST} \s/+(.*/)?login\.php(?:[\s?]|$) [NC]
RewriteRule ^login\.php$ /%1login [R=302,L]

RewriteCond %{THE_REQUEST} \s/+(.*/)?pre_reg\.php(?:[\s?]|$) [NC]
RewriteRule ^pre_reg\.php$ /%1pre-register [R=302,L]

RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.php(?:[\s?]|$) [NC]
RewriteRule ^index\.php$ /%1app [R=302,L]

# Friendly route aliases
RewriteRule ^login/?$ login.php [L,QSA,NC]
RewriteRule ^pre-register/?$ pre_reg.php [L,QSA,NC]
RewriteRule ^app/([^/]+)/?$ index.php?page=$1 [L,QSA,NC]
RewriteRule ^app/?$ index.php [L,QSA,NC]

# Allow extensionless access to top-level PHP files
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^([^/.]+)/?$ $1.php [L,QSA]
